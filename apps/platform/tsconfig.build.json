{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "../../scripts/stacki/release-pin.mjs",
    "../../scripts/stacki/prepare-native-studio.mjs",
    "../../scripts/stacki/load-pinned-release.mjs",
    "../../scripts/stacki/prepare-from-confirmed-export.mjs",
    "../../scripts/stacki/prepare-git-branch.mjs",
    "../../scripts/stacki/build-handoff.mjs",
    "../../scripts/stacki/first-studio-github-push.mjs",
    "../../scripts/stacki/verify-studio-health.mjs",
    "app/**/*.ts",
    "app/**/*.tsx",
    ".next/types/**/*.ts",
    "gnr8/**/*.ts",
    "gnr8/**/*.tsx",
    "middleware.ts",
    "next-env.build.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    ".next",
    "coverage",
    "tmp-*.ts",
    "debug-*.ts",
    "inspect-*.ts",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/_tests/**",
    "**/__fixtures__/**",
    "**/fixtures/**"
  ]
}
