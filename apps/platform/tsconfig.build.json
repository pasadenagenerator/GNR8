    "app/**/*.ts",
    "app/**/*.tsx",
    ".next/types/**/*.ts",
    "gnr8/**/*.ts",
    "gnr8/**/*.tsx",
    "middleware.ts",
    "next-env.build.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    ".next",
    "coverage",
    "tmp-*.ts",
    "debug-*.ts",
    "inspect-*.ts",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/_tests/**",
    "**/__fixtures__/**",
    "**/fixtures/**"
