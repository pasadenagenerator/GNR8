{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "noEmit": false,
    "declaration": false,
    "sourceMap": false,
    "outDir": "../../dist-rendered-capture-worker",
    "rootDir": "../..",
    "types": ["node"],
    "incremental": false
  },
  "include": ["index.ts"],
  "exclude": ["**/*.test.ts", "**/*.test.tsx"]
}
