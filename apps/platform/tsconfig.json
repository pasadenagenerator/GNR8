{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "incremental": true,
    "types": [
      "node"
    ],
    // KLJUČNI POPRAVEK
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    "allowJs": true,
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "../../scripts/stacki/release-pin.mjs",
    "../../scripts/stacki/prepare-native-studio.mjs",
    "../../scripts/stacki/native-access-roles.mjs",
    "../../scripts/stacki/native-access-role-freshness.mjs",
    "../../scripts/stacki/first-studio-github-push.mjs",
    "../../scripts/stacki/verify-studio-health.mjs",
    "../../scripts/stacki/load-pinned-release.mjs",
    "../../scripts/stacki/prepare-from-confirmed-export.mjs",
    "../../scripts/stacki/build-artifact-transfer.mjs",
    "../../scripts/stacki/verified-studio-checkout.mjs",
    "../../scripts/stacki/build-artifact-git-commit.mjs",
    "../../scripts/stacki/build-artifact-github-push.mjs",
    "../../scripts/stacki/build-artifact-github-restore.mjs",
    "../../scripts/stacki/materialize-studio-image-site.mjs",
    "../../scripts/stacki/studio-image-archive.mjs",
    "../../scripts/stacki/trusted-studio-deploy.mjs",
    "../../scripts/stacki/first-studio-deploy-identity.mjs",
    "../../scripts/stacki/first-studio-dry-run.mjs",
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "tmp-*.ts",
    "debug-*.ts",
    "inspect-*.ts"
  ]
}
