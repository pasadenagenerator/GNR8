{
  "name": "@gnr8/worker",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "typecheck": "pnpm exec tsc --noEmit",
    "clean": "find .next -maxdepth 1 -name 'cache*' -exec rm -rf {} + 2>/dev/null || true",
    "build": "pnpm run clean && pnpm exec next build",
    "test": "NODE_OPTIONS='--conditions=react-server' pnpm exec tsx --test gnr8/template-intake/inngest/*.test.ts gnr8/inngest/*.test.ts gnr8/site/inngest/*.test.ts gnr8/domain/inngest/*.test.ts"
  },
  "dependencies": {
    "@gnr8/core": "workspace:*",
    "@gnr8/data": "workspace:*",
    "@gnr8/runtime-contracts": "workspace:*",
    "@supabase/supabase-js": "^2.98.0",
    "inngest": "^3.54.0",
    "next": "^15.1.0",
    "parse5": "7.3.0",
    "pg": "^8.18.0",
    "server-only": "^0.0.1"
  }
}
