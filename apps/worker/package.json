{
  "name": "@gnr8/worker",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "typecheck": "pnpm exec tsc --noEmit",
    "clean": "find .next -maxdepth 1 -name 'cache*' -exec rm -rf {} + 2>/dev/null || true",
    "build": "node ../../scripts/prepare-astro-node.mjs --download && pnpm run clean && pnpm exec next build",
    "test": "NODE_OPTIONS='--conditions=react-server' pnpm exec tsx --test gnr8/template-intake/inngest/*.test.ts gnr8/inngest/*.test.ts gnr8/site/inngest/*.test.ts gnr8/domain/inngest/*.test.ts"
  },
  "dependencies": {
    "@gnr8/core": "workspace:*",
    "@gnr8/data": "workspace:*",
    "@gnr8/runtime-contracts": "workspace:*",
    "@sparticuz/chromium": "^138.0.2",
    "@supabase/supabase-js": "^2.98.0",
    "inngest": "^3.54.0",
    "next": "^15.1.0",
    "npm": "10.9.8",
    "parse5": "7.3.0",
    "pg": "^8.18.0",
    "playwright": "^1.59.1",
    "playwright-core": "^1.59.1",
    "pnpm": "10.28.2",
    "server-only": "^0.0.1",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  }
}
